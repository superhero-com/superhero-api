{
  "name": "wordcraft-api",
  "version": "1.0.3",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 127.0.0.1:9229 --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "smoke:dex": "node scripts/smoke-dex-invariants.mjs",
    "smoke:dex:diff": "node scripts/smoke-dex-differential.mjs",
    "typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "migrate:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/data-source.js",
    "migrate:prod:locked": "node ./scripts/migrate-with-lock.js",
    "migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "postinstall": "node ./scripts/update-package-type.js && rm -rf ./node_modules/bctsl-sdk/.build && tsc -b ./node_modules/bctsl-sdk/tsconfig.cjs.json ./node_modules/bctsl-sdk/tsconfig.esm.json ./node_modules/bctsl-sdk/tsconfig.types.json"
  },
  "dependencies": {
    "@aeternity/aepp-sdk": "^15.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@bull-board/api": "^9.3.2",
    "@bull-board/express": "^9.3.2",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/bull": "^11.0.5",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.1",
    "bctsl-sdk": "git+ssh://git@github.com/bctsl/bctsl-sdk#v1.0.0",
    "bignumber.js": "^9.3.1",
    "bull": "^4.16.5",
    "cache-manager": "^7.2.9",
    "camelcase-keys-deep": "^0.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dex-contracts-v2": "github:aeternity/dex-contracts-v2",
    "dotenv": "^17.4.1",
    "express": "^5.1.0",
    "graphql": "^16.14.2",
    "graphql-type-json": "^0.3.2",
    "hbs": "^4.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "keyv": "^5.6.0",
    "lru-cache": "^11.5.2",
    "moment": "^2.30.1",
    "nestjs-typeorm-paginate": "^4.1.0",
    "nostr-tools": "^2.24.3",
    "pg": "^8.23.0",
    "proxy-addr": "^2.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.31",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.43",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "@types/node": "20.19.43"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src/",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?(?:nostr-tools|@noble|@scure)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/test/(.*)$": "<rootDir>/../test/$1",
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}

# Dedicated media worker environment. Do not copy the API environment or signer keys.
NODE_ENV=production
# Load only the dedicated process environment, never an API checkout's .env.
DOTENV_CONFIG_PATH=/dev/null
ENABLE_SHORTS=true
AE_NETWORK_ID=ae_uat
SHORTS_TESTNET_MVP=1
SHORTS_DEMO_AUTO_APPROVE=0
SHORTS_DEMO_CONNECTED_WALLET=0
DB_TYPE=postgres
DB_HOST=postgres.internal
DB_PORT=5432
DB_DATABASE=superhero
DB_USER=shorts_media_worker
DB_PASSWORD=replace-via-deployment-secret
DB_SYNC=false
DB_POOL_MAX=5
DB_POOL_MIN=1
SHORTS_DEPLOYMENT_FILE=/run/secrets/deployment.json
SHORTS_PRIVATE_S3_ENDPOINT=https://s3.example.com
SHORTS_PRIVATE_S3_REGION=us-east-1
SHORTS_PRIVATE_S3_BUCKET=superhero-private-uploads
SHORTS_PRIVATE_S3_PREFIX=shorts-private-v1
SHORTS_PRIVATE_S3_PATH_STYLE=true
SHORTS_PRIVATE_S3_CREDENTIALS_FILE=/run/secrets/private-s3.json
SHORTS_PRIVATE_ENCRYPTION_KEYS_FILE=/run/secrets/private-keys.json
SHORTS_MODERATION_URL=https://moderation.example.com
SHORTS_MODERATION_TOKEN_FILE=/run/secrets/moderation-token
SHORTS_WORKER_TMP_DIR=/tmp
# Floors on the instance-owned scratch volume; includes the stricter percentage floor.
SHORTS_WORKER_MIN_FREE_BYTES=67108864
SHORTS_WORKER_MIN_FREE_INODES=128
SHORTS_WORKER_MAX_USED_PERCENT=85
# Shared processing capacity is stored in shorts_runtime.max_processing (default 2).
# It is not multiplied or overridden by adding worker processes.
SHORTS_WORKER_LEASE_MS=120000
# Optional topic classifier. It never approves content.
SHORTS_JEV_ENABLED=0

# Dedicated Shorts SQL pool per process; independent of the main API pool (1–16).
SHORTS_DB_CONCURRENCY=4

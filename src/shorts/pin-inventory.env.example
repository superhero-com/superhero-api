NODE_ENV=production
ENABLE_SHORTS=true
AE_NETWORK_ID=ae_uat
SHORTS_DEPLOYMENT_FILE=/run/config/shorts-deployment.json
DB_HOST=postgres.internal
DB_PORT=5432
DB_DATABASE=superhero
DB_USER=shorts_pin_inventory
DB_PASSWORD=replace-through-your-secret-manager
DB_SYNC=false
DB_LOGGING=false
SHORTS_DB_CONCURRENCY=1
# One node, private HTTPS. Dedicated pin/stat/id-only credential; never API write key.
SHORTS_PIN_API=https://ipfs.internal:8443/api/v0
SHORTS_PIN_TOKEN_FILE=/run/secrets/shorts-ipfs-inventory-token
SHORTS_PIN_PEER_ID=replace-with-the-verified-node-peer-id
# For a private CA, also set NODE_EXTRA_CA_CERTS to the trusted mounted CA file.

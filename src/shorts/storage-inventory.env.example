NODE_ENV=production
ENABLE_SHORTS=true
AE_NETWORK_ID=ae_uat
SHORTS_DEPLOYMENT_FILE=/run/config/shorts-deployment.json
DB_HOST=postgres.internal
DB_PORT=5432
DB_DATABASE=superhero
DB_USER=shorts_storage_inventory
DB_PASSWORD=replace-through-your-secret-manager
DB_SYNC=false
DB_LOGGING=false
SHORTS_DB_CONCURRENCY=1
SHORTS_PRIVATE_S3_ENDPOINT=https://s3.example.com
SHORTS_PRIVATE_S3_REGION=us-east-1
SHORTS_PRIVATE_S3_BUCKET=superhero-private-uploads
SHORTS_PRIVATE_S3_PREFIX=shorts-private-v1
SHORTS_PRIVATE_S3_PATH_STYLE=true
# Separate identity: prefix-restricted s3:ListBucketVersions only. No Get/Put/Delete.
SHORTS_PRIVATE_S3_CREDENTIALS_FILE=/run/secrets/shorts-storage-inventory.json
# Do not mount encryption, signing or media-service keys.

NODE_ENV=production
ENABLE_SHORTS=true
AE_NETWORK_ID=ae_uat
SHORTS_DEPLOYMENT_FILE=/run/config/shorts-deployment.json
DB_HOST=postgres.internal
DB_PORT=5432
DB_DATABASE=superhero
DB_USER=shorts_hls_inventory
DB_PASSWORD=replace-through-your-secret-manager
DB_SYNC=false
DB_LOGGING=false
SHORTS_DB_CONCURRENCY=1
# Match the streaming deployment; use its dedicated read-only inventory account.
SHORTS_HLS_REDIS_URL=rediss://shorts_hls_inventory@redis.internal:6379/0
SHORTS_HLS_REDIS_PASSWORD_FILE=/run/secrets/shorts-hls-inventory-password
SHORTS_HLS_NAMESPACE=shorts-hls-v2
# No playback, edge, IPFS, S3, encryption, moderation or signing keys are needed.

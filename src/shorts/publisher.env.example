# Dedicated publisher environment. Never copy the API/media worker environment.
ENABLE_SHORTS=true
AE_NETWORK_ID=ae_uat
SHORTS_TESTNET_MVP=1
SHORTS_DEMO_AUTO_APPROVE=0
SHORTS_DEMO_CONNECTED_WALLET=0
DOTENV_CONFIG_PATH=/dev/null
DB_TYPE=postgres
DB_HOST=postgres.internal
DB_PORT=5432
DB_DATABASE=superhero
DB_USER=shorts_publisher
DB_PASSWORD=replace-via-deployment-secret
DB_SYNC=false
# Same versioned release manifest as the API/setup (README.md).
SHORTS_DEPLOYMENT_FILE=/run/secrets/deployment.json
SHORTS_CONTRACT_ARTIFACT=/run/secrets/Shorts.json
SHORTS_PUBLISHING_POLICY_FILE=/run/secrets/publishing-policy.json
# File must belong to the runtime UID and have no group/other permissions.
SHORTS_OPERATOR_KEY_FILE=/run/secrets/operator.json
# Optional. Must match the release manifest's node exactly; no silent override.
# SHORTS_PUBLISHER_NODE_URL=https://testnet.aeternity.io
SHORTS_PUBLISHER_POLL_MS=5000

# Dedicated Shorts SQL pool per process; independent of the main API pool (1–16).
SHORTS_DB_CONCURRENCY=4

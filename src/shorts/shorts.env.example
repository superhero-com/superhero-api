ENABLE_SHORTS=false
AE_NETWORK_ID=ae_uat
# Hosted indexing uses the normal API PostgreSQL connection and MDW pipeline.
# Apply all API migrations first. Hosted state uses PostgreSQL and private S3.
# Existing local data must use the offline migration in LEGACY-STORAGE.md before startup.
# Keep one API instance until distributed ingress limits and capacity validation are complete.
DISABLE_MDW_SYNC=false
# Required when running the normal API with NODE_ENV=production.
SHORTS_WEB_ORIGIN=https://staging.example.com
SHORTS_TESTNET_MVP=1
# Hosted API: signing key belongs only to the isolated publisher (see PUBLISHER.md).
SHORTS_PUBLISHING_POLICY_FILE=/absolute/private/shorts/publishing-policy.json
# Loopback local-main demo only:
# SHORTS_OPERATOR_KEY_FILE=/absolute/private/shorts/operator.json
# Versioned release manifest, including ABI hash/treasury/economics. See README.md.
SHORTS_DEPLOYMENT_FILE=/absolute/private/shorts/deployment.json
SHORTS_CONTRACT_ARTIFACT=/absolute/path/superhero-shorts-contract/artifacts/Shorts.json
# Do not set SHORTS_DATA_DIR on the hosted API. Migrate existing local state offline.
# Loopback demo / offline migration only:
# SHORTS_DATA_DIR=/absolute/private/shorts/data
# Capacity includes the active mutation; excess requests receive HTTP 503.
SHORTS_MAX_PENDING_OPERATIONS=8
# Queued requests expire before starting; active transactions are never retried by this timeout.
SHORTS_OPERATION_WAIT_MS=30000
# Multipart input and finish admission share this process-wide request limit.
# One active upload request per authenticated wallet; excess returns 429/503.
SHORTS_CONCURRENT_UPLOADS=2
# Hosted Redis ceiling across all APIs (1–64); identical on every replica.
SHORTS_SHARED_CONCURRENT_UPLOADS=4
# Separate hosted rescan/preview/recovery transfers across all APIs (1–64).
# One transfer per creator. Same value and SHORTS_RATE_KEY_FILE on every replica.
SHORTS_SHARED_CONCURRENT_MEDIA=2
# Fixed body-receive deadline; slow unfinished multipart connections are closed.
SHORTS_UPLOAD_BODY_TIMEOUT_MS=120000
# Overall upload request deadline, including private S3 IO and metadata (1–600 seconds).
SHORTS_UPLOAD_OPERATION_TIMEOUT_MS=180000
# Loopback demo queue capacity. Hosted shared admission is currently fixed at 8 jobs, 2 per wallet.
SHORTS_INGEST_QUEUE_CAPACITY=8
# Hosted HTTP admission uses shared Redis and an owner-only secret file (RATE-LIMITS.md).
# SHORTS_RATE_KEY_FILE=/run/secrets/shorts-rate-key
# TRUST_PROXY=127.0.0.1/32
# Use the existing REDIS_HOST / REDIS_PORT / REDIS_PASSWORD settings.
# Required for hosted Shorts uploads. Loopback-only demo retains local private storage.
# See PRIVATE-STORAGE.md. Provision the private bucket separately; do not expose its keys to clients.
# SHORTS_PRIVATE_S3_ENDPOINT=https://s3.example.com
# Browser-reachable origin for the same MinIO bucket; see DIRECT-UPLOADS.md for CORS.
# Required on the hosted API for direct uploads (not required on workers).
# SHORTS_PRIVATE_S3_UPLOAD_ENDPOINT=https://uploads.example.com
# SHORTS_PRIVATE_S3_REGION=us-east-1
# SHORTS_PRIVATE_S3_BUCKET=superhero-private-uploads
# SHORTS_PRIVATE_S3_PREFIX=shorts-private-v1
# SHORTS_PRIVATE_S3_PATH_STYLE=true
# SHORTS_PRIVATE_S3_CREDENTIALS_FILE=/run/secrets/shorts-private-s3.json
# SHORTS_PRIVATE_ENCRYPTION_KEYS_FILE=/run/secrets/shorts-private-encryption.json
SHORTS_IPFS_API=http://127.0.0.1:35002/api/v0
# Required for remote storage: absolute path to the mounted server-only key.
# SHORTS_IPFS_TOKEN_FILE=/run/secrets/superhero-ipfs-staging-storage-token
# For a private CA: NODE_EXTRA_CA_CERTS=/run/secrets/ipfs-ca.pem
SHORTS_MODERATION_URL=http://127.0.0.1:3340
SHORTS_MODERATION_TOKEN_FILE=/absolute/private/shorts/moderation-token

# Local testnet demo only: bypass scanning and feed review until switched off.
SHORTS_DEMO_AUTO_APPROVE=0
# Local demo only: trust the connected address for Studio data without signing in.
SHORTS_DEMO_CONNECTED_WALLET=0

# Optional text-topic suggestions. Disabled by default; never an automatic approval.
SHORTS_JEV_ENABLED=0
SHORTS_JEV_MODEL=
TYPESAFE_API_KEY=

# Optional upgrade: required together when the new contract references a previous deployment.
# SHORTS_PREVIOUS_DEPLOYMENT_FILE=/absolute/private/shorts/previous-deployment.json
# SHORTS_PREVIOUS_CONTRACT_ARTIFACT=/absolute/private/shorts/previous-artifact.json

# HLS preparation outbox. Private origin (not the public edge); server-only key.
# Hosted publication and playback jobs commit together in PostgreSQL; see STREAMING-OUTBOX.md.
# API sends IDs, retries unavailable workers, and reclaims expired dispatcher leases.
# SHORTS_STREAM_INTERNAL_URL=https://streaming-internal.example.com
# SHORTS_STREAM_KEY_FILE=/run/secrets/api-to-streaming-key

# Dedicated Shorts SQL pool per process; independent of the main API pool (1–16).
SHORTS_DB_CONCURRENCY=4

# Retained-upload count/byte limits live in PostgreSQL, not per API process.
# Set them with the trusted Nest setup command; see UPLOAD-BUDGET.md.

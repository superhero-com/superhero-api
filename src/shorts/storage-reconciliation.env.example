NODE_ENV=production
ENABLE_SHORTS=true
AE_NETWORK_ID=ae_uat
SHORTS_DEPLOYMENT_FILE=/run/config/shorts-deployment.json
DB_HOST=postgres.internal
DB_PORT=5432
DB_DATABASE=superhero
DB_USER=shorts_storage_reconciliation
DB_PASSWORD=replace-through-your-secret-manager
DB_SYNC=false
DB_LOGGING=false
SHORTS_DB_CONCURRENCY=1
SHORTS_PRIVATE_S3_ENDPOINT=https://s3.example.com
SHORTS_PRIVATE_S3_REGION=us-east-1
SHORTS_PRIVATE_S3_BUCKET=superhero-private-uploads
SHORTS_PRIVATE_S3_PREFIX=shorts-private-v1
SHORTS_PRIVATE_S3_PATH_STYLE=true
# Separate identity: deployment-prefix-restricted s3:GetObject only. No List/Put/Delete.
SHORTS_PRIVATE_S3_CREDENTIALS_FILE=/run/secrets/shorts-storage-reconciliation.json
# Same private-media key ring, including retained older keys.
SHORTS_PRIVATE_ENCRYPTION_KEYS_FILE=/run/secrets/shorts-private-encryption.json
# Do not mount signing or media-service keys.
